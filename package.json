{
  "name": "nagi",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "wrangler dev --port 5317",
    "check": "tsc -b && biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply nagi --local",
    "db:migrate:remote": "wrangler d1 migrations apply nagi --remote",
    "release": "pnpm db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260925.2",
    "@types/node": "^22.20.4",
    "@vitest/runner": "~4.1.11",
    "@vitest/snapshot": "~4.1.11",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "~4.1.11",
    "wrangler": "^4.140.0"
  },
  "engines": {
    "node": ">=22"
  }
}
