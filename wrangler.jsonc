{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nagi",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  "assets": {
    // 画面ファイルは Vite のビルド結果（@cloudflare/vite-plugin が directory を決める）
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nagi",
      // `wrangler d1 create nagi --location apac` で作った本番の D1（APAC）
      "database_id": "770a86db-0365-4b58-ab4f-842f1d0684d3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_TIMEZONE": "Asia/Tokyo",
    // GitHub の OAuth App「nagi」（myksyut が持ち主）の Client ID。秘密ではない
    "GITHUB_CLIENT_ID": "Ov23licDbYh47XzAIdS6",
    // ログインを許可する GitHub ユーザー（myksyut）の ID
    "ALLOWED_GITHUB_USER_ID": "51072711"
  }
  // GITHUB_CLIENT_SECRET はシークレット。Cloudflare のダッシュボードで入れる
}
