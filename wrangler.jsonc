{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nagi",
  // Worker がすべてのリクエストを受ける（画面のファイルは配らない。クライアントは TUI）
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  // 版ごとのプレビュー URL（<版の ID の先頭>-nagi.<サブドメイン>.workers.dev）は出さない。
  // 出したままだと、Web 版だったころの古い版が、その URL から開けてしまう
  "preview_urls": false,
  // 独自ドメイン。ダッシュボードで足した Custom Domain を、デプロイで保つ
  "routes": [{ "pattern": "api.usenagi.dev", "custom_domain": true }],
  // 独自ドメインに移る前の nagi は https://nagi.wizard1026miya.workers.dev を見続けるので、この URL も止めない
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nagi",
      // `wrangler d1 create nagi --location apac` で作った本番の D1（APAC）
      "database_id": "770a86db-0365-4b58-ab4f-842f1d0684d3",
      "migrations_dir": "migrations"
    }
  ],
  // 回数制限は 10 秒か 60 秒の窓だけ。上限は src/worker/rate-limit.ts の呼び出し側（index.ts）の名前と対応する
  "ratelimits": [
    // /auth/device/start：IP ごとに 60 秒で 5 回
    {
      "name": "AUTH_START_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    // /auth/device/token と /auth/logout：IP ごとに 60 秒で 30 回（5 秒ごとのポーリングは 12 回）
    {
      "name": "AUTH_POLL_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    // /api/*：利用者ごとに 60 秒で 600 回
    { "name": "API_LIMITER", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } }
  ],
  // D1 のバックアップの置き場。バケットは `wrangler r2 bucket create nagi-backups` で作る（35 日ぶんだけ残す。src/worker/ops/backup.ts）
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "nagi-backups" }],
  "triggers": {
    "crons": [
      // 期限切れのセッションの掃除。毎日 日本時間の 4 時 17 分（UTC の 19 時 17 分）
      "17 19 * * *",
      // D1 のバックアップ。毎日 日本時間の 4 時 37 分（UTC の 19 時 37 分）
      "37 19 * * *"
    ]
  },
  "vars": {
    "APP_TIMEZONE": "Asia/Tokyo",
    // GitHub の OAuth App「nagi」（myksyut が持ち主）の Client ID。秘密ではない。
    // ログインはデバイスフローなので、Client secret は使わない（OAuth App で「Enable Device Flow」を有効にしておく）
    "GITHUB_CLIENT_ID": "Ov23licDbYh47XzAIdS6",
    // 利用者を分ける前からあったデータの持ち主（myksyut）の GitHub ユーザー ID。この人は、いつでもログインできる
    "OWNER_GITHUB_USER_ID": "51072711",
    // だれが登録・ログインできるか。"allowlist" は、持ち主と ALLOWED_GITHUB_USER_IDS の人だけ。
    // "open" にすると、GitHub のアカウントがあればだれでも登録できる
    "SIGNUP": "allowlist",
    // "allowlist" のときに登録・ログインできる GitHub ユーザー ID（カンマ区切り。例："1002,1003"）。
    // ID は https://api.github.com/users/<ユーザー名> の id
    "ALLOWED_GITHUB_USER_IDS": ""
  }
}
